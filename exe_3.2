#include &lt;stdio.h&gt;
#include &lt;fcntl.h&gt;
#include &lt;unistd.h&gt;
int main()
{
    int fd;


    fd = open(&quot;sample.txt&quot;, O_RDONLY);
    if(fd &lt; 0)
    {
        printf(&quot;File Opening Failed\n&quot;);
        return 1;
    }
    printf(&quot;File Opened Successfully\n&quot;);
    close(fd);
    printf(&quot;File Closed Successfully\n&quot;);
    return 0;
}
